{
  "name": "Email Validation API",
  "brand": "CheckNumber",
  "slug": "email-validation-api",
  "repository": "checkernumber/email-validation-api",
  "description": "Asynchronous file-based Email Validation checks.",
  "official_site": "https://checknumber.ai",
  "landing_page": "https://checknumber.ai/products/email-validation",
  "canonical_docs": "https://docs.checknumber.ai/email-deliverability-checker/",
  "dashboard": "https://platform.checknumber.ai",
  "base_url": "https://api.checknumber.ai",
  "mode": "async",
  "auth": {
    "type": "api_key",
    "header": "X-API-Key"
  },
  "endpoints": {
    "create_task": {
      "method": "POST",
      "path": "/v1/tasks"
    },
    "get_task": {
      "method": "POST",
      "path": "/v1/gettasks"
    },
    "balance": {
      "method": "GET",
      "path": "/v1/balance"
    }
  },
  "input": {
    "file_format": "text file, one valid email address per line according to task type"
  },
  "products": [
    {
      "task_type": "email_check",
      "name": "Upload Task",
      "doc_slug": "email-bulk-checker",
      "input_kind": "email",
      "min_numbers": 1,
      "max_numbers": 10000000,
      "result_fields": [
        "email",
        "activated"
      ],
      "min_billable_numbers": 2000,
      "available": true
    }
  ],
  "pricing_url": "https://checknumber.ai/pricing",
